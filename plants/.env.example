# Store mode: "local" (JSON files in .plants-data/) or "supabase"
PLANTS_STORE=local

# Public URL (magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth — owner-only edit access
ADMIN_EMAIL=joachim@noobwork.no
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Magic link email (production)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Plants · Noobwork <onboarding@resend.dev>

# Local dev: print login link in terminal/UI when Resend is not set
PLANTS_DEV_LOGIN=true

# Seed 3 demo plants when store is empty (set false once you have real data)
PLANTS_SEED_DEMO=true

# Supabase (when PLANTS_STORE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI vision for photo check-ins (optional — stub without it)
OPENAI_API_KEY=

# Vercel Blob for persistent photo storage (production)
BLOB_READ_WRITE_TOKEN=

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joachim@noobwork.no

# Open-Meteo Seoul humidity nudge (set false to disable)
OPEN_METEO_ENABLED=true

# Cron protection (Vercel)
CRON_SECRET=
