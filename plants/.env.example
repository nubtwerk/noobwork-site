# Store mode: "local" (JSON files in .plants-data/) or "supabase"
PLANTS_STORE=local

# Public URL (magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth — owner-only edit access
ADMIN_EMAIL=joachim@noobwork.no
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Magic link email (production)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Plants · Noobwork <onboarding@resend.dev>

# Local dev: print login link in terminal/UI when Resend is not set
PLANTS_DEV_LOGIN=true

# Supabase (when PLANTS_STORE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI vision for photo check-ins (optional — stub without it)
OPENAI_API_KEY=

# Cron protection (Vercel)
CRON_SECRET=
