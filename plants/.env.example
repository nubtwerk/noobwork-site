# Store mode: "local" (JSON files in .plants-data/) or "supabase"
PLANTS_STORE=local

# Supabase (when PLANTS_STORE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision analysis (optional — photo check-ins work without it)
ANTHROPIC_API_KEY=

# Cron protection (Vercel)
CRON_SECRET=
