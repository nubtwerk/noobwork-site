# Optional — E2E / local only. When set to "stub", the contact API accepts
# valid inquiries without calling Resend. Never set this in production.
# CONTACT_EMAIL_MODE=stub

# Optional — required for the Media Kit contact form to send email.
# Create a free API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=

# Defaults to joachim@noobwork.no when unset.
CONTACT_TO_EMAIL=

# Defaults to Resend onboarding sender until a verified domain is configured.
CONTACT_FROM_EMAIL=

# Optional — Season 1 follower list (double opt-in, stored in Resend Contacts).
# Both IDs are required. Broadcasts must target the Season segment AND topic.
# Missing configuration disables signup; existing global unsubscribes stay in place.
RESEND_SEASON_SEGMENT_ID=
RESEND_SEASON_TOPIC_ID=
# Sender for Season follow confirmations and bidding emails. Must be on a domain
# verified in Resend, e.g. Season <season@noobwork.no>. Falls back to CONTACT_FROM_EMAIL.
SEASON_FROM_EMAIL=
# Optional signing key for confirmation links. Defaults to one derived from RESEND_API_KEY.
SEASON_FOLLOW_SECRET=

# Optional — for scripts/generate-atmosphere.mjs (local dev only; never deploy to Vercel).
# Create at https://cloud.higgsfield.ai → API keys.
# Format: KEY_ID:KEY_SECRET (or use HF_API_KEY + HF_API_SECRET instead).
HF_CREDENTIALS=

# Optional — Season sponsor bidding (/season). Without these, local dev uses an
# in-memory store and production falls back to the inquiry form. Partial hosted
# configuration also disables bidding. Memory/demo mode is local-only.
# Schema and functions: supabase/season-bids.sql.
# Required to turn bidding on: a fresh random secret of 32+ characters, the season_bids_* functions check
# (its SHA-256 is stored in season_private.api_secrets).
SEASON_DB_SECRET=
# Required together: the NEW dedicated sponsorship project (no inherited defaults).
SEASON_SUPABASE_PROJECT_REF=
SEASON_SUPABASE_URL=
SEASON_SUPABASE_KEY=
# Password for /season/admin (16+ characters recommended; runtime minimum 12).
# Shared with /season/admin/challenge.
SEASON_ADMIN_PASSWORD=
# Soft page password for /season and its viewer child routes (not admin).
# HttpOnly cookie after a correct POST to /api/season/unlock. Unset fails closed
# (gate stays up; nothing can unlock). Example for local/preview:
# SEASON_PAGE_PASSWORD=Julia123
SEASON_PAGE_PASSWORD=
# Local screenshots only: "demo" seeds sample bids into the in-memory store.
# SEASON_BIDS_STORE=demo

# Optional — Season 1 community challenge (docs/community-challenge.md).
# Uses the same dedicated Season database settings as sponsor bidding (SEASON_SUPABASE_PROJECT_REF,
# SEASON_SUPABASE_URL, SEASON_SUPABASE_KEY, SEASON_DB_SECRET). Without them, previews and local runs use
# demo data; production shows the challenge as not open. No service role key is used.
# Signs runners' personal links. 32+ random characters. Changing it breaks existing links.
CHALLENGE_SECRET=
