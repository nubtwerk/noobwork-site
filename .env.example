# Optional — E2E / local only. When set to "stub", the contact API accepts
# valid inquiries without calling Resend. Never set this in production.
# CONTACT_EMAIL_MODE=stub

# Optional — required for the Media Kit contact form to send email.
# Create a free API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=

# Defaults to joachim@noobwork.no when unset.
CONTACT_TO_EMAIL=

# Defaults to Resend onboarding sender until a verified domain is configured.
CONTACT_FROM_EMAIL=

# Optional — for scripts/generate-atmosphere.mjs (local dev only; never deploy to Vercel).
# Create at https://cloud.higgsfield.ai → API keys.
# Format: KEY_ID:KEY_SECRET (or use HF_API_KEY + HF_API_SECRET instead).
HF_CREDENTIALS=

# Optional — Season sponsor bidding (/season). Without these, local dev uses an
# in-memory store and production falls back to the inquiry form.
# Schema and functions: supabase/season-bids.sql.
SEASON_SUPABASE_URL=
# The project's publishable (anon) key. It can only call the season_bids_* functions.
SEASON_SUPABASE_KEY=
# Shared secret those functions check; its SHA-256 is stored in season_private.api_secrets.
SEASON_DB_SECRET=
# Password for /season/admin (12+ characters).
SEASON_ADMIN_PASSWORD=
# Local screenshots only: "demo" seeds sample bids into the in-memory store.
# SEASON_BIDS_STORE=demo
